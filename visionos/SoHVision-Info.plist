<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- visionOS only hands extended gamepads (DualSense, Xbox) and the PS VR2 Sense
	     controllers (SpatialGamepad) to apps that declare them. -->
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>SpatialGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<!-- Multiple scenes: the game window plus the "Cine" ImmersiveSpace. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UIApplicationPreferredDefaultSceneSessionRole</key>
		<string>UIWindowSceneSessionRoleApplication</string>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<!-- Cinema ghost controllers (SenseGhosts): ARKit accessory tracking of the
	     PS VR2 Sense controllers, and hand tracking to tell a resting controller
	     from one in the hand. Requested only when the cinema opens. -->
	<key>NSAccessoryTrackingUsageDescription</key>
	<string>Muestra dónde están los mandos PS VR2 Sense apoyados mientras juegas en el modo Cine.</string>
	<key>NSHandsTrackingUsageDescription</key>
	<string>Distingue si tienes un mando PS VR2 Sense en la mano para mostrarlo solo cuando está apoyado (modo Cine).</string>
</dict>
</plist>
